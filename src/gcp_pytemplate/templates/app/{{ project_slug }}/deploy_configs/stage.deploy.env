# GCP (shared)
GCP_PROJECT="{{ gcp_project }}"
GCP_REGION="{{ gcp_region }}"
SERVICE_ACCOUNT_EMAIL="{{ gcp_service_account }}"

# App config
APP_CONFIG="stage.env"

{% if include_cloud_run %}
# Cloud Run (service)
GCR_SERVICE_NAME="{{ project_slug }}-stage"
GCR_MIN_INSTANCES=0
GCR_MAX_INSTANCES=10
GCR_CPU="1"
GCR_MEMORY="512Mi"
GCR_CONCURRENCY=80
GCR_TIMEOUT=300
{% endif %}
{% if include_cloud_run_jobs %}
# Cloud Run Job (CLI)
GCRJ_JOB_NAME="{{ project_slug }}-stage"
GCRJ_CPU="1"
GCRJ_MEMORY="512Mi"
GCRJ_TASK_TIMEOUT="600s"
GCRJ_TASKS=1
GCRJ_PARALLELISM=0
GCRJ_MAX_RETRIES=3
{% endif %}
