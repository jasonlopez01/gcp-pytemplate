# GCP (shared)
GCP_PROJECT="my-gcp-project"
GCP_REGION="us-west2"
SERVICE_ACCOUNT_EMAIL="my-service-account@my-gcp-project.iam.gserviceaccount.com"

# Artifact Registry
GAR_REPO="demo-images"
IMAGE_TAG="stage"

# App config
APP_CONFIG="stage.env"


# Cloud Run (service)
GCR_SERVICE_NAME="example-api-service-stage"
GCR_MIN_INSTANCES=0
GCR_MAX_INSTANCES=10
GCR_CPU="1"
GCR_MEMORY="512Mi"
GCR_CONCURRENCY=80
GCR_TIMEOUT=300

