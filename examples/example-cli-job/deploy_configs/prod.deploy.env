# GCP (shared)
GCP_PROJECT="my-gcp-project"
GCP_REGION="us-west2"
SERVICE_ACCOUNT_EMAIL="my-service-account@my-gcp-project.iam.gserviceaccount.com"

# Artifact Registry
GAR_REPO="demo-images"
IMAGE_TAG="latest"

# App config
APP_CONFIG="prod.env"



# Cloud Run Job (CLI)
GCRJ_JOB_NAME="example-cli-job"
# GCRJ_CPU="1"
# GCRJ_MEMORY="512Mi"
# GCRJ_TASK_TIMEOUT="600s"
# GCRJ_TASKS=1
# GCRJ_PARALLELISM=0
# GCRJ_MAX_RETRIES=3
